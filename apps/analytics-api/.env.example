# ===== Analytics API (apps/analytics-api) — Production env =====
# ตั้งค่าใน Render Dashboard → Environment (อย่า commit ค่าจริง)

# --- Database (ตัวเดียวกับ POS) ---
# ใช้ DIRECT connection (port 5432) เพราะ pandas/SQLAlchemy ทำงานดีกับ direct
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-1-xxx.pooler.supabase.com:5432/postgres"

# --- AI: Gemini (Primary) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- AI: OpenRouter (Fallback, ทางเลือก) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-9b-it

# --- App ---
# PORT ไม่ต้องตั้ง — Render กำหนดให้อัตโนมัติ ($PORT)
# โดเมนที่อนุญาต (CORS) — คั่นหลายอันด้วย comma
CORS_ORIGINS="https://your-analytics-web.vercel.app,https://your-pos-web.vercel.app"
