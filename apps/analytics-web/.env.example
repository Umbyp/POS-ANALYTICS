# ===== Analytics Web (apps/analytics-web) — Production env =====
# ตั้งค่าใน Vercel → Project Settings → Environment Variables

# URL ของ Analytics API (Render)
NEXT_PUBLIC_ANALYTICS_API="https://your-analytics-api.onrender.com"

# URL ของหน้า Dashboard บน POS system — ใช้สำหรับปุ่ม "Back to POS"
NEXT_PUBLIC_POS_URL="https://your-pos-web.vercel.app/dashboard"
